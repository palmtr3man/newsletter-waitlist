# The Ultimate Journey — Newsletter Waitlist Environment Variables
# Copy this file to .env for local development and set the same public URL values
# in Netlify for production, deploy-preview, branch-deploy, and dev contexts.
# Never commit real secrets or private API keys.

# --- Public app URLs used by email CTA generation ---
# Server-side source for boarding-pass CTA links.
# Expected boarding CTA format: https://newsletter-waitlist.netlify.app/?boarding=<position>
APP_BASE_URL=https://newsletter-waitlist.netlify.app

# Client/build fallback for app URL generation. Keep aligned with APP_BASE_URL unless
# a temporary deploy preview or branch context explicitly needs a different host.
VITE_APP_URL=https://newsletter-waitlist.netlify.app

# Public workbook CTA used by the gifted-dashboard block in boarding emails.
# This URL must serve a valid XLSX from the app host, not the Beehiiv publication host.
BEEHIIV_GIFT_LINK_URL=https://newsletter-waitlist.netlify.app/dashboard-v2.xlsx

# --- Required private runtime variables ---
# Fetch from provider dashboards and set in Netlify only; do not place real values here.
SENDGRID_API_KEY=your-sendgrid-api-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
DATABASE_URL=your-database-url-here
